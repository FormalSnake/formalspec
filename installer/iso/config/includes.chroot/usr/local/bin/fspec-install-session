#!/bin/bash
# Exit 2 from fspec-install means "leave me a login shell"; any other exit relaunches it.
export FSPEC_SESSION=1
rc_file=/run/fspec-install/exit
tty=$(tty)
quick=0

# sway does not pass the client's exit status through, so the exec line in sway.conf writes it down.
run_sway() {
	mkdir -p /run/fspec-install
	rm -f "$rc_file"
	WLR_RENDERER_ALLOW_SOFTWARE=1 sway --config /etc/fspec-install/sway.conf
	[ -f "$rc_file" ] || return 255
	return "$(cat "$rc_file")"
}

use_sway() {
	case $tty in /dev/tty[0-9]*) ;; *) return 1 ;; esac
	grep -q 'console=ttyS' /proc/cmdline && return 1
	compgen -G '/dev/dri/card*' >/dev/null
}

while true; do
	started=$SECONDS
	if use_sway; then
		run_sway
		rc=$?
		if [ "$rc" = 255 ]; then
			echo "fspec-install-session: sway did not start, using the console" >&2
			fspec-install
			rc=$?
		fi
	else
		echo "fspec-install-session: starting fspec-install on $tty" >&2
		fspec-install
		rc=$?
	fi

	[ "$rc" = 2 ] && break

	if [ $((SECONDS - started)) -lt 2 ]; then
		quick=$((quick + 1))
	else
		quick=0
	fi
	if [ "$quick" -ge 3 ]; then
		echo "fspec-install-session: fspec-install keeps failing (exit $rc), dropping to a shell" >&2
		break
	fi
	sleep 1
done

exec bash -l
